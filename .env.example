# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id
NEXT_PUBLIC_APPWRITE_BUCKET_ID=your_bucket_id
NEXT_PUBLIC_APPWRITE_API_KEY=your_api_key

# Web Push (VAPID) — 執行 `npx web-push generate-vapid-keys` 產生金鑰
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# Vercel Cron Secret — 自訂隨機字串，用於驗證 /api/push-send Cron Job
CRON_SECRET=your_random_cron_secret

# Resend Email — 用於 /api/resend-expiry-notify 每日到期提醒
RESEND_API_KEY=your_resend_api_key
RESEND_TO_EMAIL=you@example.com
RESEND_API_KEY2=your_second_resend_api_key
RESEND_TO_EMAIL2=you2@example.com
RESEND_API_KEY3=your_third_resend_api_key
RESEND_TO_EMAIL3=you3@example.com
RESEND_FROM_EMAIL=FengBro <onboarding@resend.dev>
