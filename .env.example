# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id
NEXT_PUBLIC_APPWRITE_BUCKET_ID=your_bucket_id
NEXT_PUBLIC_APPWRITE_API_KEY=your_api_key

# Web Push (VAPID) — 執行 `npx web-push generate-vapid-keys` 產生金鑰
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# Vercel Cron Secret — 自訂隨機字串，用於驗證 /api/push-send Cron Job
CRON_SECRET=your_random_cron_secret

# LitMedia 剩餘點數 —— 讀 AutoSignLitVideo 每日簽到發佈的 streaks.json
# （LitMedia 用量 API 要求請求簽章，只有 token 進不去，所以改讀簽到結果）
# 公開檔案，免認證，不需要任何金鑰；只有換 repo 或分支時才需要設定這一項
# LITMEDIA_STREAKS_URL=https://raw.githubusercontent.com/huang1988pioneer/AutoSignLitVideo/results/streaks.json

# MindVideo/GPT Image 2 專屬點數 —— 讀 AutoSignMindVideo 每日簽到發佈的 streaks.json（做法照抄 LitMedia）
# 公開檔案，免認證，不需要任何金鑰（不再需要 MINDVIDEO_GITHUB_TOKEN）；只有換 repo 或分支時才需要設定這一項
# MINDVIDEO_STREAKS_URL=https://raw.githubusercontent.com/huang1988pioneer/AutoSignMindVideo/results/streaks.json

# 鋒兄額度 accessToken 的四位數密碼不放這裡 —— 比照 Resend 通知密碼，
# 第一次使用時在額度頁自行設定，以 scrypt hash 存在 notificationsettings 表。

# Resend Email — 用於 /api/resend-expiry-notify 每日到期提醒
RESEND_API_KEY=your_resend_api_key
RESEND_TO_EMAIL=you@example.com
